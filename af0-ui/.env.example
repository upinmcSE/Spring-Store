# URL cơ sở của Backend API (Gateway AF0)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Bật/tắt chế độ Mock API (true: dùng dữ liệu giả lập + localStorage, false: gọi BE thật)
VITE_USE_MOCK_API=true

# Đường dẫn bí mật dành riêng cho Admin Portal (chỉ Admin biết URL này)
VITE_ADMIN_BASE_PATH=/ls-admin-portal

