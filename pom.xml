<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.upinmcse</groupId>
    <artifactId>af0</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>AF0 Store</name>
    <url>...</url>
    <licenses>
        <license>
            <name>..</name>
            <url>..</url>
            <distribution>..</distribution>
        </license>
    </licenses>

    <modules>
        <module>af0-server</module>
        <module>af0-framework</module>
        <module>af0-system</module>
        <module>af0-product</module>
        <module>af0-order</module>
        <module>af0-notification</module>
        <module>af0-gateway</module>
        <module>af0-manufacturing</module>
        <module>af0-inventory</module>
        <module>af0-payment</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-boot.version>4.1.1</spring-boot.version>
        <lombok.version>1.18.46</lombok.version>

        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <jspecify.version>1.0.1</jspecify.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.0</version>
        </dependency>

        <dependency>
            <groupId>org.modelmapper</groupId>
            <artifactId>modelmapper</artifactId>
            <version>3.2.4</version>
        </dependency>

    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.github.upinmcse</groupId>
                <artifactId>af0-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.upinmcse</groupId>
                <artifactId>af0-dao</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.upinmcse</groupId>
                <artifactId>af0-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.upinmcse</groupId>
                <artifactId>af0-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.upinmcse</groupId>
                <artifactId>af0-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.upinmcse</groupId>
                <artifactId>af0-system</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.upinmcse</groupId>
                <artifactId>af0-product</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.upinmcse</groupId>
                <artifactId>af0-order</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.upinmcse</groupId>
                <artifactId>af0-notification</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.upinmcse</groupId>
                <artifactId>af0-manufacturing</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <!-- Not inheriting spring-boot-starter-parent means nothing adds -parameters for us.
                         Without it Spring cannot discover parameter names: constructor binding,
                         @ConfigurationProperties and unnamed @PathVariable/@RequestParam all break. -->
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
